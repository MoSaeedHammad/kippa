rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == householdId
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('householdIds', []).hasAny([householdId]));
    }

    // Access level of the caller in the given household, as set by the owner
    // at join approval (updateMemberAccessLevel / decideJoinRequest callables).
    // A missing memberships entry means 'full' so legacy members are unaffected.
    function householdAccessLevel(householdId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        .get('memberships', {})
        .get(householdId, {})
        .get('accessLevel', 'full');
    }

    function isFullHouseholdMember(householdId) {
      return isHouseholdMember(householdId) && householdAccessLevel(householdId) == 'full';
    }

    function isHouseholdOwner(householdId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/householdInfo/info)
        && get(/databases/$(database)/documents/households/$(householdId)/householdInfo/info).data.createdBy == request.auth.uid;
    }

    function isValidAiMemory(data, householdId) {
      return data.keys().hasOnly(['id', 'householdId', 'scope', 'userId', 'kind', 'content', 'confidence', 'sourceMessageIds', 'createdAt', 'updatedAt', 'lastConfirmedAt', 'supersededBy'])
        && data.householdId == householdId
        && data.scope == 'user'
        && data.userId == request.auth.uid
        && data.kind in ['fact', 'preference', 'goal', 'decision', 'correction', 'pattern', 'outcome']
        && data.content is string
        && data.content.size() >= 3
        && data.content.size() <= 500
        && data.confidence is number
        && data.confidence >= 0
        && data.confidence <= 1
        && data.sourceMessageIds is list
        && data.sourceMessageIds.size() <= 20
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /households/{householdId} {
      // AI messages are user-authored nested records. The parent conversation
      // stores createdBy; members may only access their own conversation threads.
      match /aiConversations/{conversationId} {
        allow read: if isFullHouseholdMember(householdId)
          && resource.data.createdBy == request.auth.uid;
        allow create: if isFullHouseholdMember(householdId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isFullHouseholdMember(householdId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy;

        match /messages/{messageId} {
          allow read: if isFullHouseholdMember(householdId)
            && get(/databases/$(database)/documents/households/$(householdId)/aiConversations/$(conversationId)).data.createdBy == request.auth.uid;
          allow create: if isFullHouseholdMember(householdId)
            && get(/databases/$(database)/documents/households/$(householdId)/aiConversations/$(conversationId)).data.createdBy == request.auth.uid
            && request.resource.data.conversationId == conversationId;
          allow update, delete: if false;
        }
      }

      match /aiMemories/{memoryId} {
        allow create: if isFullHouseholdMember(householdId)
          && request.resource.data.id == memoryId
          && isValidAiMemory(request.resource.data, householdId);
        allow read: if isFullHouseholdMember(householdId)
          && request.auth.uid == resource.data.userId;
        allow update: if isFullHouseholdMember(householdId)
          && request.auth.uid == resource.data.userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidAiMemory(request.resource.data, householdId);
        allow delete: if false;
      }

      // Pending bank messages expose account hints and balances — full
      // members only. Approval is server-only (Admin SDK bypasses rules).
      match /pendingFinancialMessages/{pendingId} {
        allow read: if isFullHouseholdMember(householdId);
        allow write: if false;
      }

      // Shared-balance entries are the only financial collection visible to
      // shared-balance-only members. All writes go through callables so the
      // counterparty-approval rule is enforced server-side.
      match /sharedBalanceEntries/{entryId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if false;
      }

      // Recurring shared-balance rules: any member reads (shared-balance-only
      // members manage their own rules); every write goes through callables.
      match /recurringSharedEntryRules/{ruleId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if false;
      }

      // Any member (any access level) registers push tokens and own settings,
      // otherwise shared-balance-only members could never be notified.
      match /fcmTokens/{tokenId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /notificationSettings/{settingUid} {
        allow read, write: if isHouseholdMember(householdId)
          && settingUid == request.auth.uid;
      }

      // Default: full members can read/write household data. Shared-balance
      // only members are excluded because accounts, transactions, cards,
      // statements and the audit log all reveal private financial details.
      // (pendingFinancialMessages, sharedBalanceEntries,
      // recurringSharedEntryRules, fcmTokens, notificationSettings,
      // aiConversations and aiMemories are matched above.)
      match /{collectionName}/{documentId} {
        allow read, write: if collectionName != 'pendingFinancialMessages'
          && collectionName != 'sharedBalanceEntries'
          && collectionName != 'recurringSharedEntryRules'
          && collectionName != 'fcmTokens'
          && collectionName != 'notificationSettings'
          && collectionName != 'aiConversations'
          && collectionName != 'aiMemories'
          && isFullHouseholdMember(householdId);
      }

      // Household info is readable by any signed-in user (so joiners can
      // verify an id exists), creatable only by the user who will own it,
      // and editable/deletable by members.
      match /householdInfo/info {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isHouseholdMember(householdId);
      }

      // Join requests: a signed-in user may create their own pending request.
      // Only the owner may list/read all requests; a requester may read their own.
      // Status updates are server-only (Admin SDK bypasses rules).
      match /joinRequests/{requesterUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == requesterUid || isHouseholdOwner(householdId));
        allow create: if isSignedIn()
          && request.auth.uid == requesterUid
          && request.resource.data.uid == requesterUid
          && request.resource.data.status == 'pending';
        allow update, delete: if false;
      }
    }

    // Shortcut credentials and deduplication receipts are server-only. The
    // client sees only redacted credential summaries through callable functions.
    match /messageIngestionCredentials/{credentialId} {
      allow read, write: if false;
    }

    match /messageIngestionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /system/{docId} {
      // Runtime app configuration (e.g. the Kip AI provider settings in
      // system/aiConfig). Any signed-in user may read it; writes happen only
      // from the Firebase console / Admin SDK.
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      // A user can read their own doc, create it on signup, and edit profile
      // fields. The membership fields (householdId, householdIds, role and
      // memberships — which carries the access level the rules trust) are
      // server-only — EXCEPT the client may switch its active householdId to
      // a value already present in its own householdIds. householdIds, role
      // and memberships are immutable from the client (they must equal their
      // prior server value); only the owner-side callables can change them.
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.householdId == null
        && (!('householdIds' in request.resource.data)
            || request.resource.data.householdIds.size() == 0)
        && !('memberships' in request.resource.data);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.householdIds == resource.data.householdIds
        && request.resource.data.get('memberships', {}) == resource.data.get('memberships', {})
        && (
          request.resource.data.householdId == resource.data.householdId
          || (
            'householdIds' in request.resource.data
            && request.resource.data.householdId in request.resource.data.householdIds
          )
        );

      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
