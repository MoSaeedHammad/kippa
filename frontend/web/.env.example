VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push VAPID key — generate in Firebase Console > Project Settings >
# Cloud Messaging > Web Push certificates. Required for push notifications.
VITE_FIREBASE_VAPID_KEY=

# Gemini is called directly from the PWA. This value is bundled into the
# frontend and must be restricted to the intended web origins and API.
VITE_GEMINI_API_KEY=

# --- Kip AI assistant ---
# Pick the provider explicitly ('glm' | 'gemini'); when omitted, GLM is used
# if its key is set, otherwise Gemini.
#VITE_AI_PROVIDER=glm
# GLM (Zhipu) — https://open.bigmodel.cn — OpenAI-compatible endpoint.
#VITE_GLM_API_KEY=
#VITE_GLM_MODEL=glm-4.6
# Gemini (legacy fallback) — https://aistudio.google.com/apikey
#VITE_GEMINI_API_KEY=
